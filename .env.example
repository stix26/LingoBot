# ========================================
# LingoBot Environment Configuration
# ========================================
# Copy this file to .env and update the values below

# ========================================
# REQUIRED VARIABLES
# ========================================

# Session secret for secure session management
# Generate a strong random string for production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# OpenAI API key for AI chat functionality
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ========================================
# OPTIONAL VARIABLES
# ========================================

# Database URL for persistent storage (optional)
# If not provided, the app will use in-memory storage
# Format: postgresql://username:password@host:port/database
# DATABASE_URL=postgresql://lingobot:lingobot@localhost:5432/lingobot

# Rate limiting configuration
# Maximum number of API requests per time window
RATE_LIMIT=100

# Rate limiting time window in milliseconds (default: 1 minute)
RATE_WINDOW=60000

# ========================================
# ENVIRONMENT
# ========================================

# Application environment
# Options: development, production, test
NODE_ENV=development

# ========================================
# DEVELOPMENT ONLY
# ========================================

# Port for the development server (default: 3000)
# PORT=3000

# ========================================
# PRODUCTION SETTINGS
# ========================================

# Trust proxy for production deployments
# Set to true if behind a reverse proxy (nginx, etc.)
# TRUST_PROXY=false

# Cookie settings for production
# Set to true for HTTPS-only cookies
# COOKIE_SECURE=false

# ========================================
# LOGGING
# ========================================

# Log level for application logging
# Options: error, warn, info, debug
# LOG_LEVEL=info

# ========================================
# NOTES
# ========================================
# 
# 1. Never commit your .env file to version control
# 2. Use strong, unique values for SESSION_SECRET in production
# 3. Keep your OpenAI API key secure and never share it publicly
# 4. For production, consider using a proper database instead of in-memory storage
# 5. Adjust rate limiting based on your expected usage patterns
